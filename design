module comp ( input [3:0]a, [3:0]b, output greater,lesser,equal);
always @(*) begin
  if ( a > b) begin
  greater = 1;
  lesser = 0;
  equal = 0;
  end
  else if ( a < b ) begin
  greater = 0;
  lesser = 1;
  equal = 0;
  end
  else begin
  greater = 0;
  lesser = 0;
  equal = 1;
  end
  end
endmodule
